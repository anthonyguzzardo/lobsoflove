{
  "expo": {
    "name": "LobsOfLove",
    "slug": "lobsoflove",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-v2.png",
    "scheme": "lobsoflove",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon-v2.png",
      "bundleIdentifier": "com.mrfox.lobsoflove",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#eee9df",
        "foregroundImage": "./assets/images/android-icon-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mrfox.lobsoflove",
      "icon": "./assets/images/app-icon-v2.png",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#eee9df",
          "image": "./assets/images/app-icon-v2.png",
          "imageWidth": 260
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LobsOfLove uses your photos so you can add a picture to a match.",
          "cameraPermission": "LobsOfLove uses the camera so you can snap a photo at the start of a match.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "LobsOfLove uses motion to tell which way you are holding the phone, so your writing reads the right way up."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#e2562f"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a807cb26-4e38-42c5-ad79-ace3c343952b"
      }
    },
    "owner": "anthonyguzzardo"
  }
}
